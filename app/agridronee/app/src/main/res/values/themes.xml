<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Agridronee" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- ✅ Primary Colors -->
        <item name="colorPrimary">@color/deepGreen</item>
        <item name="colorPrimaryVariant">@color/darkGray</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- ✅ Background Fix -->
        <item name="android:windowBackground">@color/earthyBeige</item>
        <item name="android:colorBackground">@color/white</item> <!-- ✅ Fix: Correct attribute -->
        <item name="colorOnBackground">@color/black</item>

        <!-- ✅ Text Colors -->
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/darkGray</item>

        <!-- Add this to your themes.xml -->
        <item name="bottomNavigationStyle">@style/TransparentBottomNavigationView</item>
    </style>
</resources>
