<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Define BodyText Style -->
    <style name="BodyText">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#000000</item> <!-- Black text -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="HeaderText">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#000000</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CustomBottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@android:color/transparent</item>
        <item name="itemBackground">@android:color/transparent</item>
        <item name="itemIconTint">@android:color/white</item>
        <item name="itemTextColor">@android:color/white</item>
        <item name="itemRippleColor">@android:color/transparent</item>
    </style>

    <!-- Add this to your styles.xml -->
    <style name="TransparentBottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@android:color/transparent</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="itemBackground">@android:color/transparent</item>
        <item name="itemIconTint">@android:color/white</item>
        <item name="itemTextColor">@android:color/white</item>
        <item name="itemRippleColor">@android:color/transparent</item>
        <item name="itemActiveIndicatorStyle">@null</item>
    </style>

</resources>
